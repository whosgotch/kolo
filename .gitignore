# binaries
/kolo
/dist/

# recordings of agent sessions
#
# A recording is a picture of somebody's screen — their paths, their email,
# whatever else was on it — so none of them belong in the repository. Tests use
# written-out screens instead, and can replay a local recording on request.
*.cast
*.raw
*.screen
**/testdata/*.raw

# a local org
#
# Running kolo in this repository writes one here. A real org file belongs in
# version control — it holds hashes, never tokens — but this one is somebody's
# scratch org, and its members are whoever they were testing with.
/org.json

.DS_Store
